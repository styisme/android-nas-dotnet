<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AndroidNas.App.Pages.WebViewPage"
             Title="Web 控制台"
             BackgroundColor="{StaticResource MdSurface}">
    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Padding="8" ColumnSpacing="8">
            <Label x:Name="UrlLabel" Text="" VerticalOptions="Center"
                   Style="{StaticResource MdBodyMedium}" LineBreakMode="TailTruncation" />
            <Button Grid.Column="1" Text="🔄" Style="{StaticResource MdButtonTonal}" Clicked="OnReload" />
            <Button Grid.Column="2" Text="🌐" Style="{StaticResource MdButtonTonal}" Clicked="OnExternal" />
        </Grid>

        <WebView Grid.Row="1" x:Name="Browser" Navigating="OnNavigating" />
    </Grid>
</ContentPage>
