<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <RootNamespace>AndroidNas.Client</RootNamespace>
    <ApplicationTitle>NAS Client</ApplicationTitle>
    
    <!-- 统一包名，支持 Debug 后缀 -->
    <ApplicationId Condition="'$(Configuration)'=='Debug'">com.androidnas.next.client.debug</ApplicationId>
    <ApplicationId Condition="'$(Configuration)'=='Release'">com.androidnas.next.client</ApplicationId>
    
    <ApplicationDisplayVersion>4.0.0-preview</ApplicationDisplayVersion>
    <ApplicationVersion>2</ApplicationVersion>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <AndroidTargetSdkVersion>35</AndroidTargetSdkVersion>
    <AndroidMinSdkVersion>26</AndroidMinSdkVersion>
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidLinkMode>None</AndroidLinkMode>
  </PropertyGroup>
  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#00897B" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#00897B" BaseSize="128,128" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <ProjectReference Include="..\AndroidNas.Core\AndroidNas.Core.csproj" />
  </ItemGroup>
</Project>
