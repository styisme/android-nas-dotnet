<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- 改为仅目标为 Android，避免在宿主环境寻找 Linux 运行时依赖 -->
    <TargetFramework>net10.0-android</TargetFramework>
    <RootNamespace>AndroidNas.Server</RootNamespace>
    <AndroidLinkMode>SdkOnly</AndroidLinkMode>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- 忽略 SSH.NET 的漏洞警告 -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- 尝试升级以消除警告，如果最新版可用会自动生效 -->
    <PackageReference Include="SSH.NET" Version="2024.2.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AndroidNas.Core\AndroidNas.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\wwwroot\**\*" />
  </ItemGroup>
</Project>
