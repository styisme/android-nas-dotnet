<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>AndroidNas.TV</RootNamespace>
    <ApplicationTitle>NAS TV</ApplicationTitle>
    
    <ApplicationId Condition="'$(Configuration)'=='Debug'">com.androidnas.new.tv.debug</ApplicationId>
    <ApplicationId Condition="'$(Configuration)'=='Release'">com.androidnas.new.tv</ApplicationId>
    
    <SupportedOSPlatformVersion>22.0</SupportedOSPlatformVersion>
    <AndroidTargetSdkVersion>35</AndroidTargetSdkVersion>
    <AndroidMinSdkVersion>22</AndroidMinSdkVersion>
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <AndroidResource Include="Resources\**\*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AndroidNas.Core\AndroidNas.Core.csproj" />
  </ItemGroup>
</Project>
